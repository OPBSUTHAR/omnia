{
  "id": "/omnia/",
  "name": "Omnia — One app. Every device.",
  "short_name": "Omnia",
  "description": "A local-first toolkit for every screen you own: focus timer, unit converter, scratchpad and live in-app update alerts.",
  "start_url": "/omnia/",
  "scope": "/omnia/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#08080C",
  "theme_color": "#6D4AFF",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open toolkit",
      "short_name": "Tools",
      "url": "/omnia/tools",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "/omnia/settings",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
