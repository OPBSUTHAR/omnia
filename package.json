{
  "name": "omnia",
  "version": "1.0.0",
  "private": true,
  "description": "Omnia — one app, every device. A cross-platform super-app shell with live update alerts, per-device sessions and a growing toolkit.",
  "author": "Omprakash Suthar (https://github.com/OPBSUTHAR)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OPBSUTHAR/omnia.git"
  },
  "homepage": "https://opbsuthar.github.io/omnia/",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:web": "expo export --platform web",
    "verify": "npm run typecheck && npm run build:web",
    "icons": "node scripts/generate-icons.mjs",
    "release:patch": "node scripts/version.mjs patch",
    "release:minor": "node scripts/version.mjs minor",
    "release:major": "node scripts/version.mjs major",
    "release:feed": "node scripts/write-feed.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/ui": "~58.0.23",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "sharp": "^0.34.0",
    "typescript": "~6.0.3"
  }
}
